# Where the PayPilot FastAPI backend runs. The website proxies /api/* to it (see next.config.ts).
# Local: run `uvicorn api.index:app --reload --port 8000` in the repo root.
# Vercel: the backend project's URL, e.g. https://paypilot-api.vercel.app (no trailing slash needed).
BACKEND_URL=http://127.0.0.1:8000
