# PayPilot backend configuration. Copy to .env (never commit .env) or set these in the Vercel project settings.
# Every variable is optional: with no keys at all PayPilot runs offline in demo mode on its simulators.
# The website (web/) has its own web/.env.example with a single variable, BACKEND_URL.

# ---------------------------------------------------------------- PayPal Sandbox
# developer.paypal.com > Apps & Credentials > switch to Sandbox > Create App (or open the Default Application)
# > copy the Client ID and Secret. Sandbox only: PayPilot never talks to live PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same app page > Sandbox Webhooks > Add Webhook. URL: https://<your-backend>/api/v1/webhooks/inbound/paypal
# Events: Invoicing > Invoice paid, refunded, cancelled; Payment capture refunded. Copy the Webhook ID it shows.
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------- Claude
# console.anthropic.com > Settings > API Keys > Create Key. Without it a rule-based parser understands the
# example commands instead.
ANTHROPIC_API_KEY=
# Any Claude model id with tool use. Default: claude-sonnet-5-5
PAYPILOT_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- Business
# Default currency for amounts with no symbol (INR or USD).
PAYPILOT_CURRENCY=INR
# Which payment provider new invoices go to: paypal or razorpay.
PAYPILOT_PAYMENT_PROVIDER=paypal
# Shown on invoices and in messages.
PAYPILOT_BUSINESS_NAME=Asha Design Studio
PAYPILOT_BUSINESS_EMAIL=asha@studio.example

# ---------------------------------------------------------------- Razorpay test mode
# dashboard.razorpay.com > switch to Test Mode > Account & Settings > API Keys > Generate Test Key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test Mode > Account & Settings > Webhooks > Add New Webhook. URL: https://<your-backend>/api/v1/webhooks/inbound/razorpay
# Events: invoice.paid, invoice.partially_paid, invoice.cancelled, invoice.expired, refund.processed. Choose a secret and paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Customer and owner notifications
# Email via any SMTP server (Gmail: smtp.gmail.com, port 587, an App Password from
# myaccount.google.com > Security > App passwords; or your provider's SMTP settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address; defaults to SMTP_USER.
SMTP_FROM=
# Slack: api.slack.com/apps > Create App > Incoming Webhooks > Add New Webhook to Workspace > copy the URL.
# The URL itself is the credential.
SLACK_WEBHOOK_URL=
# WhatsApp via Twilio: console.twilio.com > Account Info (SID and Auth Token); Messaging > Try it out >
# Send a WhatsApp message for the sandbox sender, written like whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Where owner notifications (Settings > Notify me) are emailed.
PAYPILOT_OWNER_EMAIL=

# ---------------------------------------------------------------- Access and secrets
# Owner login for the website when open access is off. Pick a long password.
PAYPILOT_OWNER_PASSWORD=
# Signs the owner session cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If unset it is derived from PAYPILOT_OWNER_PASSWORD (changing the password then logs everyone out).
PAYPILOT_SESSION_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/v1/events/dispatch (retries failed
# webhook deliveries). Generate it the same way as the session secret.
CRON_SECRET=

# ---------------------------------------------------------------- Storage
# Reserved for Postgres (Neon: console.neon.tech > project > Connection string). NOT implemented yet:
# PayPilot currently ignores it and always uses SQLite.
DATABASE_URL=
# SQLite file used when demo mode is off. Default: data/paypilot.db locally, the temp dir on Vercel
# (ephemeral: it resets on cold starts and is not shared between instances).
PAYPILOT_DB=
# Folder for the per-visitor demo workspaces (one SQLite file each). Default: the system temp dir.
PAYPILOT_DB_DIR=

# ---------------------------------------------------------------- Website and modes
# The website's URL, e.g. https://paypilot.vercel.app. Enables CORS for it, and the backend's "/" redirects
# there when it is https.
PAYPILOT_FRONTEND_URL=
# Blank = automatic: demo mode when no PayPal, Razorpay or Claude key is set. true forces the simulators and
# per-visitor workspaces even with keys; false turns demo mode off.
PAYPILOT_DEMO_MODE=
# Blank = same as demo mode. true lets anyone use the website without logging in; false requires
# PAYPILOT_OWNER_PASSWORD. Keep it false whenever real sandbox keys are set.
PAYPILOT_OPEN_ACCESS=

# ---------------------------------------------------------------- Local testing only
# Signs simulator webhooks. The default works; change it only to test signature failures.
PAYPILOT_SIM_WEBHOOK_SECRET=
# Allow outbound webhook subscriptions to http:// or private-network URLs (e.g. a local receiver).
PAYPILOT_ALLOW_HTTP_WEBHOOKS=
PAYPILOT_ALLOW_PRIVATE_WEBHOOKS=
